# backend/.env.example
NODE_ENV=development
PORT=3000

# CORS — liste blanche séparée par des virgules, restreinte en
# production. Vide/non défini en dev : toute origine est autorisée.
# CORS_ALLOWED_ORIGINS="https://admin.example.com,https://app.example.com"

# PostgreSQL (Neon) — voir schema.prisma pour l'extension postgis requise
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secrets JWT — générer avec `openssl rand -hex 64`, jamais commiter de vraie valeur
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_HASH_PEPPER="change-me-pepper"
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3

# Paiements — aucune variable d'environnement générique ici : chaque
# prestataire (Orange Money...) authentifie ses propres webhooks selon
# son propre schéma, implémenté dans son adaptateur
# (src/payments/providers/*.provider.ts, voir payment-provider-adapter.interface.ts).
# Les secrets de chaque prestataire (clé API, clé de signature...) se
# déclarent au fur et à mesure, par prestataire, dans ce même fichier.

# SMS — "console" journalise le code au lieu de l'envoyer (dev uniquement)
SMS_PROVIDER=console

# Stockage de fichiers (pièces justificatives chauffeur/véhicule) —
# Cloudflare R2 par défaut, mais tout stockage compatible S3 fonctionne
# en changeant uniquement STORAGE_ENDPOINT (AWS S3, Backblaze B2...).
# Tant que ces variables ne sont pas renseignées, le reste du backend
# démarre normalement — seuls les endpoints d'upload/téléchargement
# échoueront (voir storage.service.ts).
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID="change-me"
STORAGE_SECRET_ACCESS_KEY="change-me"
STORAGE_BUCKET="occaz-documents"
# Optionnel — uniquement si le bucket a un domaine public configuré côté
# Cloudflare (cas non recommandé pour des pièces d'identité, mais
# recommandé pour les photos de profil chauffeur — préfixe
# "driver-avatar/", voir DriverProfilesService.requestPhotoUploadUrlForUser)
# ; sinon, chaque lecture passe par une URL signée temporaire qui expire
# (voir createDownloadUrl).
# STORAGE_PUBLIC_BASE_URL="https://documents.example.com"

# Géocodage — autocomplétion d'adresse réelle (remplace la saisie 100%
# manuelle des Location). Mapbox choisi pour son offre gratuite généreuse
# (100 000 requêtes/mois) — voir GeocodingProvider pour changer de
# fournisseur sans toucher au reste de l'app. Tant que cette variable
# n'est pas renseignée, le reste du backend démarre normalement — seuls
# /geocoding/search et /geocoding/reverse échoueront, avec un message clair.
MAPBOX_ACCESS_TOKEN="change-me"

# Push (Expo) — gratuit, aucun compte à créer, fonctionne dès maintenant
# sans cette variable. Optionnel : uniquement utile à volume élevé (accès
# prioritaire côté Expo).
# EXPO_ACCESS_TOKEN="change-me"

# Email (Resend) — RESEND_FROM_EMAIL doit être sur un domaine vérifié
# dans Resend. Tant que ces deux variables sont absentes, le backend
# démarre normalement, seul l'envoi réel échoue proprement.
# RESEND_API_KEY="change-me"
# RESEND_FROM_EMAIL="no-reply@ton-domaine.com"


# Push (Expo) — gratuit, aucun compte à créer, fonctionne dès maintenant
# sans cette variable. Optionnel : uniquement utile à volume élevé (accès
# prioritaire côté Expo).
# EXPO_ACCESS_TOKEN="change-me"