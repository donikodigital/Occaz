# backend/.env.example
NODE_ENV=development
PORT=3000

# CORS — liste blanche séparée par des virgules, restreinte en
# production. Vide/non défini en dev : toute origine est autorisée.
# CORS_ALLOWED_ORIGINS="https://admin.example.com,https://app.example.com"

# Adresse du back-office (sans « / » final). Sert au bouton « Ouvrir dans le back-office » des emails d'alerte de l'équipe
# (ex. retrait à valider). Non défini : l'email part sans bouton.
# ADMIN_PANEL_URL="https://admin.example.com"

# PostgreSQL (Neon) — voir schema.prisma pour l'extension postgis requise
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secrets JWT — générer avec `openssl rand -hex 64`, jamais commiter de vraie valeur
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OTP — codes SMS (connexion, remise, changement de numéro)
# OTP_HASH_PEPPER (OBLIGATOIRE) : secret qui entre dans le hachage des codes (HMAC-SHA256). Sans lui, quiconque lit la base
# retrouverait n'importe quel code à 6 chiffres en une fraction de seconde. Générer avec `openssl rand -hex 32` (32 caractères
# minimum, différent de JWT_ACCESS_SECRET et JWT_REFRESH_SECRET). Ne JAMAIS le changer une fois en production sans prévenir :
# les codes en attente (5 minutes au plus) deviennent invalides, ce qui est sans conséquence si on le fait hors des heures de pointe.
OTP_HASH_PEPPER="change-me-pepper"

# Tous les réglages ci-dessous sont aussi modifiables dans l'administration (Paramètres → Connexion et SMS), sans
# redéployer. Ordre de priorité : valeur de l'administration > variable ci-dessous > valeur par défaut indiquée.
# Durée de validité d'un code, en secondes (défaut 300, minimum 30).
OTP_EXPIRY_SECONDS=300
# Essais autorisés par code avant blocage (défaut 3).
OTP_MAX_ATTEMPTS=3

# Paiements — aucune variable d'environnement générique ici : chaque
# prestataire (Orange Money...) authentifie ses propres webhooks selon
# son propre schéma, implémenté dans son adaptateur
# (src/payments/providers/*.provider.ts, voir payment-provider-adapter.interface.ts).
# Les secrets de chaque prestataire (clé API, clé de signature...) se
# déclarent au fur et à mesure, par prestataire, dans ce même fichier.

# SMS — "console" journalise le code au lieu de l'envoyer (dev uniquement)
# SMS (TextBee) — gratuit (50/jour, 300/mois), passerelle via un
# téléphone Android réel. Tant que TEXTBEE_API_KEY ou TEXTBEE_DEVICE_ID
# n'est pas renseignée, le backend démarre normalement, seul l'envoi réel
# échoue proprement. TEXTBEE_DEVICE_ID est l'identifiant de l'appareil
# lié (dashboard TextBee > Devices) — l'API l'exige désormais dans
# l'URL, sinon elle répond "No enabled device found".
# TEXTBEE_API_KEY="change-me"
# TEXTBEE_DEVICE_ID="change-me"

# Stockage de fichiers (pièces justificatives conducteur/véhicule) —
# Cloudflare R2 par défaut, mais tout stockage compatible S3 fonctionne
# en changeant uniquement STORAGE_ENDPOINT (AWS S3, Backblaze B2...).
# Tant que ces variables ne sont pas renseignées, le reste du backend
# démarre normalement — seuls les endpoints d'upload/téléchargement
# échoueront (voir storage.service.ts).
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID="change-me"
STORAGE_SECRET_ACCESS_KEY="change-me"
STORAGE_BUCKET="occaz-documents"
# Optionnel — uniquement si le bucket a un domaine public configuré côté
# Cloudflare (cas non recommandé pour des pièces d'identité, mais
# recommandé pour les photos de profil conducteur — préfixe
# "driver-avatar/", voir DriverProfilesService.requestPhotoUploadUrlForUser)
# ; sinon, chaque lecture passe par une URL signée temporaire qui expire
# (voir createDownloadUrl).
# STORAGE_PUBLIC_BASE_URL="https://documents.example.com"

# Géocodage — autocomplétion d'adresse réelle (remplace la saisie 100%
# manuelle des Location). Mapbox choisi pour son offre gratuite généreuse
# (100 000 requêtes/mois) — voir GeocodingProvider pour changer de
# fournisseur sans toucher au reste de l'app. Tant que cette variable
# n'est pas renseignée, le reste du backend démarre normalement — seuls
# /geocoding/search et /geocoding/reverse échoueront, avec un message clair.
MAPBOX_ACCESS_TOKEN="change-me"

# Push (Expo) — gratuit, aucun compte à créer, fonctionne dès maintenant
# sans cette variable. Optionnel : uniquement utile à volume élevé (accès
# prioritaire côté Expo).
# EXPO_ACCESS_TOKEN="change-me"

# Mode test — DÉSACTIVÉ par défaut, à n'activer QUE pendant tes propres
# tests, JAMAIS avec de vrais utilisateurs sur le site public. Court-
# circuite l'OTP (code fixe 000000, aucun SMS envoyé) pour les numéros
# listés, et la 2FA (mot de passe seul suffit) pour les emails staff
# listés — tout autre compte suit le parcours normal, sans exception.
# AUTH_TEST_MODE_ENABLED=true
# AUTH_TEST_PHONE_NUMBERS="+224600000001,+224600000002"
# AUTH_TEST_STAFF_EMAILS="thiernodoniko@gmail.com"

# ---------------------------------------------------------------------
# Mise en production — variables ajoutées pour le lancement
# ---------------------------------------------------------------------
# Mode strict : en production, refuse de DÉMARRER tant qu'un réglage dangereux subsiste (paiements simulés, mode test
# actif, CORS ouvert, secrets courts, SMS/email non configurés). À activer le jour du lancement public ; sans lui, le
# serveur démarre quand même et liste les points à régler dans les logs.
# PRODUCTION_STRICT=true

# Nombre de proxys entre l'utilisateur et l'API (1 = Render seul ; 2 = Cloudflare devant Render ; 0 = aucun). Sans
# cela, la limite de débit s'appliquerait à tous les utilisateurs réunis.
# TRUST_PROXY_HOPS=1

# Documentation interactive /api/docs : désactivée par défaut en production, true pour la réactiver.
# SWAGGER_ENABLED=false

# Limites de SMS — chaque code envoie un SMS payant. Mêmes règles de priorité que ci-dessus (administration > ici > défaut).
# Demandes de code par numéro dans une fenêtre de temps (défaut : 5 par 15 minutes).
# OTP_REQUEST_LIMIT=5
# OTP_REQUEST_WINDOW_MINUTES=15
# Codes de connexion par numéro et par période de 24 h (défaut 10 ; 0 = illimité).
# OTP_DAILY_LIMIT_PER_PHONE=10
# Codes de connexion pour TOUTE la plateforme par période de 24 h (défaut 2000 ; 0 = illimité). Une fois atteint, les
# nouvelles demandes reçoivent « service saturé » et une alerte est écrite dans les journaux : à relever si l'activité est légitime.
# OTP_DAILY_LIMIT_GLOBAL=2000
# SMS de remise (prise en charge, dépose, colis) par réservation ou envoi, pour chaque étape et par période de 24 h
# (défaut 5 ; 0 = illimité). Au-delà, le code reste généré et visible dans l'application : seul le SMS n'est plus envoyé.
# OTP_HANDOVER_SMS_DAILY_LIMIT=5
# Indicatifs acceptés pour recevoir un code, séparés par des virgules (ex. +224,+33). Vide = tous les pays. Protège contre la
# fraude au SMS surtaxé (numéros étrangers appelés en boucle). Recommandé le jour du lancement : +224 (Guinée) et les
# indicatifs de la diaspora que tu souhaites accepter.
# OTP_ALLOWED_PHONE_PREFIXES=+224
# Délai entre deux changements de numéro d'un même compte, en jours (défaut 30 ; 0 = aucun délai).
# PHONE_CHANGE_COOLDOWN_DAYS=30
# SMS de notification (paiement confirmé, litige…) par utilisateur et par période de 24 h (défaut 10 ; 0 = illimité).
# Les notifications dans l'application ne sont pas concernées ; un SMS refusé est tracé comme échec du canal SMS.
# SMS_NOTIFICATION_DAILY_LIMIT_PER_USER=10

# Tâches automatiques (expiration des trajets, réservations impayées, plages d'envois) : elles tournent toujours. TRIP_EXPIRY_JOB=off,
# BOOKING_EXPIRY_JOB=off et SHIPMENT_WINDOW_JOB=off les arrêtent complètement (tests, scripts) et exigent un redémarrage. Pour une
# pause en exploitation, utilise plutôt les interrupteurs de l'administration (Paramètres → Tâches automatiques) : effet immédiat.

# Seed des comptes d'équipe (npm run seed:accounts) : mot de passe commun, 12 caractères minimum.
# SEED_STAFF_PASSWORD="change-me-long-password"

# Suivi des erreurs (Sentry) — facultatif : sans SENTRY_DSN, rien n'est envoyé et le backend se comporte comme avant.
# DSN : sentry.io → Settings → Projects → (projet backend) → Client Keys (DSN). À mettre dans les variables d'environnement
# de l'hébergeur (Render), jamais dans le dépôt.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# Traçage des performances (0 à 1) : 0 par défaut — il consomme le quota du plan gratuit.
# SENTRY_TRACES_SAMPLE_RATE=0
