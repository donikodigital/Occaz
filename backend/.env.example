# backend/.env.example
NODE_ENV=development
PORT=3000
APP_NAME=OCCAZ

# PostgreSQL (Neon) — voir schema.prisma pour l'extension postgis requise
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secrets JWT — générer avec `openssl rand -hex 64`, jamais commiter de vraie valeur
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_HASH_PEPPER="change-me-pepper"
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="change-me"
SMTP_PASS="change-me"
SMTP_FROM="no-reply@example.com"
MAIL_FROM="OCCAZ <no-reply@example.com>"

# Scheduler / cron
SCHEDULER_ENABLED=true
CRON_SECRET="change-me"

# URLs front / API
NEXT_PUBLIC_API_URL="http://localhost:3333"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3333/api"
APP_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# Notifications push (Web Push / VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=""

# Sécurité & rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Swagger
SWAGGER_ENABLED="true"
SWAGGER_PATH="docs"

# Stockage fichiers : local | cloudinary | s3
UPLOAD_DRIVER=cloudinary
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=10
UPLOAD_ALLOWED_MIME="image/jpeg,image/png,image/webp,application/pdf"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LOCAL_UPLOAD_DIR="./uploads"
LOCAL_PUBLIC_BASE_URL="http://localhost:3000/static"
STORAGE_DRIVER=

# Jobs internes
JOBS_SECRET="change-me"
JOBS_ENABLED=true

LOG_LEVEL=debug

# Cookies / CORS
COOKIE_DOMAIN="localhost"
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS="http://localhost:3000"
CORS_CREDENTIALS=true

# Paiements — aucune variable d'environnement générique ici : chaque
# prestataire (Orange Money...) authentifie ses propres webhooks selon
# son propre schéma, implémenté dans son adaptateur
# (src/payments/providers/*.provider.ts, voir payment-provider-adapter.interface.ts).
# Les secrets de chaque prestataire (clé API, clé de signature...) se
# déclarent au fur et à mesure, par prestataire, dans ce même fichier.

# SMS — "console" journalise le code au lieu de l'envoyer (dev uniquement)
SMS_PROVIDER=console
