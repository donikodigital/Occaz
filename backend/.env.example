# backend/.env.example
NODE_ENV=development
PORT=3000

# PostgreSQL (Neon) — voir schema.prisma pour l'extension postgis requise
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secrets JWT — générer avec `openssl rand -hex 64`, jamais commiter de vraie valeur
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_HASH_PEPPER="change-me-pepper"
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3

# Paiements — aucune variable d'environnement générique ici : chaque
# prestataire (Orange Money...) authentifie ses propres webhooks selon
# son propre schéma, implémenté dans son adaptateur
# (src/payments/providers/*.provider.ts, voir payment-provider-adapter.interface.ts).
# Les secrets de chaque prestataire (clé API, clé de signature...) se
# déclarent au fur et à mesure, par prestataire, dans ce même fichier.

# SMS — "console" journalise le code au lieu de l'envoyer (dev uniquement)
SMS_PROVIDER=console
