# web-admin/.env.example
# URL de base de l'API backend (voir backend/README.md — /api/v1).
# Les appels du navigateur passent par le relais same-origin /api/bff (cookies HttpOnly) : le jeton n'est plus lisible côté navigateur.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# URL de l'API utilisée par le SERVEUR Next.js (relais /api/bff). Facultatif : à défaut, NEXT_PUBLIC_API_URL est utilisée.
# API_URL=https://occaz-api.onrender.com/api/v1

# Suivi des erreurs (Sentry). Facultatif : sans DSN, rien n'est envoyé.
# NEXT_PUBLIC_SENTRY_DSN=https://<clé>@<organisation>.ingest.sentry.io/<projet>
