# mobile/.env.example
# URL de base de l'API backend (voir backend/README.md — /api/v1)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Token PUBLIC Mapbox (préfixe "pk.") pour l'affichage de carte et le
# calcul d'itinéraire côté client — distinct du MAPBOX_ACCESS_TOKEN
# secret côté backend. À restreindre par domaine sur mapbox.com avant
# la mise en production.
EXPO_PUBLIC_MAPBOX_TOKEN=change-me


# Suivi des erreurs (Sentry) — facultatif : sans EXPO_PUBLIC_SENTRY_DSN, rien n'est envoyé. Désactivé aussi en développement.
# DSN du projet « React Native » : sentry.io → Settings → Projects → (projet mobile) → Client Keys (DSN).
# Pour un build de production : à définir dans les variables d'environnement EAS (environnements production et preview).
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_SENTRY_ENVIRONMENT=production
# Traçage des performances (0 à 1) : 0 par défaut — il consomme le quota du plan gratuit.
# EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Activer quand même le suivi en développement (rarement utile) :
# EXPO_PUBLIC_SENTRY_IN_DEV=true
