# mobile/.env.example
# URL de base de l'API backend (voir backend/README.md — /api/v1)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Token PUBLIC Mapbox (préfixe "pk.") pour l'affichage de carte et le
# calcul d'itinéraire côté client — distinct du MAPBOX_ACCESS_TOKEN
# secret côté backend. À restreindre par domaine sur mapbox.com avant
# la mise en production.
EXPO_PUBLIC_MAPBOX_TOKEN=change-me