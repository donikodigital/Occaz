{
  "expo": {
    "name": "Transport Partagé",
    "slug": "transport-partage",
    "scheme": "transportpartage",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.transportpartage.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.transportpartage.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF9"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorisez l'accès à vos photos pour envoyer vos documents (pièce d'identité, permis, carte grise...).",
          "cameraPermission": "Autorisez l'accès à l'appareil photo pour prendre une photo de vos documents.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Autorisez la localisation pour partager votre position avec le passager pendant un trajet en cours.",
          "locationAlwaysAndWhenInUsePermission": "Autorisez la localisation en arrière-plan pour continuer à partager votre position avec le passager même si vous quittez l'application pendant un trajet en cours.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4F46E5"
        }
      ],
      "expo-image"
    ],
    "extra": {
      "apiUrl": "https://api.transport-partage.example.com/api/v1",
      "eas": {
        "projectId": "442c452f-5eb3-4de1-bb7b-ff269181bc5e"
      },
      "router": {}
    },
    "owner": "",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/442c452f-5eb3-4de1-bb7b-ff269181bc5e"
    }
  }
}
