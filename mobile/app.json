{
  "expo": {
    "name": "Occa'Z",
    "slug": "transport-partage",
    "scheme": "occaz",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "sarl.occaz.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "sarl.occaz.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B6BA8"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF9"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorisez l'accès à vos photos pour envoyer vos documents (pièce d'identité, permis, carte grise...).",
          "cameraPermission": "Autorisez l'accès à l'appareil photo pour prendre une photo de vos documents.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Autorisez l'accès à l'appareil photo pour scanner le billet ou l'étiquette d'un colis.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Autorisez la localisation pour utiliser votre position actuelle et la partager avec le passager pendant un trajet en cours.",
          "locationAlwaysAndWhenInUsePermission": "Autorisez la localisation en arrière-plan pour continuer à partager votre position avec le passager même si vous quittez l'application pendant un trajet en cours.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B6BA8",
          "sounds": [
            "./assets/sounds/message.wav"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-image"
    ],
    "extra": {
      "apiUrl": "https://api.occaz.sarl/api/v1",
      "router": {},
      "eas": {
        "projectId": "25f0cbb8-bdf1-4f1e-b652-575141e7ab75"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "doniko-digital"
  }
}
